# Required Configuration
GIT_REPO=https://github.com/username/repository.git

# Optional Configuration (with defaults)
GIT_BRANCH=main
# For multiple branches, use comma-separated list: GIT_BRANCH=main,develop,feature-x
# Set GIT_BRANCH=none (or omit GIT_BRANCH when GIT_TAG_PATTERN is set) to build tags only

# Git Tag-Triggered Builds (optional - disabled when unset)
# Comma-separated glob pattern(s) supporting * and ? (e.g., * or v* or v*,release-*)
# Triggered by GitHub push (refs/tags/*) and create (ref_type=tag) webhooks, or latest tag on poll
# Builds image tagged as <DOCKER_IMAGE_NAME>:<tag> (and :latest when TAG_LATEST=true)
# GIT_TAG_PATTERN=v*
# TAG_LATEST=true

# Trigger Mode: poll (default) | webhook | both
# - poll:    Check for new commits every CHECK_INTERVAL minutes
# - webhook: Listen for GitHub push webhooks on WEBHOOK_PORT
# - both:    Instant GitHub webhooks + periodic polling fallback
TRIGGER_MODE=poll

# Run an initial check/build immediately when the container starts (optional)
# Defaults to true in poll/both mode, false in webhook mode
# RUN_ON_STARTUP=true

# Polling interval in minutes (used when TRIGGER_MODE is poll or both)
CHECK_INTERVAL=60

# Command timeouts in seconds (0 disables timeout)
# GIT_TIMEOUT_SECONDS=300
# BUILD_TIMEOUT_SECONDS=1800
# COMPOSE_TIMEOUT_SECONDS=300
# WATCHTOWER_TIMEOUT_SECONDS=120

# Webhook Configuration (used when TRIGGER_MODE is webhook or both)
WEBHOOK_PORT=9000
WEBHOOK_PATH=/webhook
# Webhook secret - use mounted file (recommended) or environment variable
# Generate one with: openssl rand -hex 32
# WEBHOOK_SECRET_FILE=/app/secrets/webhook_secret (default location for mounted secret file)
# WEBHOOK_SECRET=your_random_webhook_secret_here

# Git Authentication - use mounted file (recommended) or environment variable
# GIT_PAT_FILE=/app/secrets/pat (default location for mounted PAT file)
GIT_PAT=ghp_your_github_personal_access_token_here

DOCKERFILE_PATH=.
DOCKER_IMAGE_NAME=my-auto-built-image

# Additional flags passed to `docker buildx build` (optional)
# Example: DOCKER_BUILD_FLAGS=--target production --no-cache
# DOCKER_BUILD_FLAGS=

# Image tag (optional) - if not provided, defaults to: branch-git-hash-7chars (when SHOULD_TAG_EACH_BUILD=true)
# Example: main-abc1234
# IMAGE_TAG=my-auto-built-image:custom-tag

# Tag each build (optional) - set to true to generate unique IMAGE_TAG for each build
# When false, only IMAGE_BRANCH tag will be applied (e.g., myapp:main)
# When true and IMAGE_TAG is not set, generates: myapp:main-abc1234
# SHOULD_TAG_EACH_BUILD=false

# Custom build script (optional) - replaces default docker build command
# Use this to customize the build process, use alternative build tools, or add pre/post processing
# The script receives all necessary environment variables (IMAGE_TAG, BUILD_CONTEXT, etc.)
# See scripts/build.sh.example for examples
# BUILD_SCRIPT=/app/scripts/custom-build.sh

# Built-in Docker Compose / Synology Container Manager Auto-Redeploy (optional)
# Mount the target project folder at the EXACT SAME host path inside syno-builder:
#   -v /volume1/docker/my-app:/volume1/docker/my-app:ro
# COMPOSE_PROJECT_DIR=/volume1/docker/my-app
# Optional: explicit Compose project name (-p); omit to use folder name or compose.yaml `name:`
# COMPOSE_PROJECT_NAME=my-app
# Optional: comma-separated service name(s) to recreate with --no-deps (leaves DBs/Redis untouched)
# COMPOSE_SERVICE=web
# Optional: custom compose filename inside COMPOSE_PROJECT_DIR
# COMPOSE_FILE=compose.yaml
# Optional: only redeploy when this specific branch is built (useful with multi-branch GIT_BRANCH)
# COMPOSE_BRANCH=main

# Built-in Watchtower Integration (optional)
# 1. After local builds, POSTs to ${WATCHTOWER_URL}/v1/update?image=<built-image>
# 2. Forwards GitHub `package` / `registry_package` (published) events on WEBHOOK_PATH to Watchtower
# WATCHTOWER_URL=http://watchtower:8080
# WATCHTOWER_TOKEN_FILE=/app/secrets/watchtower_token (auto-excluded from Docker BuildKit secrets)
# WATCHTOWER_TOKEN=your_watchtower_http_api_token
# Optional: override target image or container name for post-build triggers
# WATCHTOWER_IMAGE=myapp:latest
# WATCHTOWER_CONTAINER=my-app
# Optional: only trigger Watchtower after builds of this specific branch
# WATCHTOWER_BRANCH=main

# Post-build script (optional) - runs after successful build (and after Compose redeploy if configured)
# The script runs detached, so commands like 'docker compose up -d' won't block
# POST_BUILD_SCRIPT=/app/scripts/post-build.sh

# Docker Build Secrets (optional)
# Mount secret files to /app/secrets directory - they will be automatically passed as BuildKit secrets during build
# Reserved files 'pat', 'webhook_secret', and 'watchtower_token' are automatically excluded from BuildKit secrets
# Example: Mount your secrets directory with: -v /path/to/local/secrets:/app/secrets:ro
